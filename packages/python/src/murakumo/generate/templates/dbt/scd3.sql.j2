        when incoming.{{ quote(column.sql) }} is distinct from existing.{{ quote(column.sql) }} then existing.{{ quote(column.sql) }}
        else existing.{{ quote(column.name) }}
    end as {{ quote(column.name) }}{{ "," if not loop.last }}
{{ '{%' }} else {{ '%}' }}
    cast(null as {{ column.data_type }}) as {{ quote(column.name) }}{{ "," if not loop.last }}
{{ '{%' }} endif {{ '%}' }}
